			seg("conveyor", "sidewalk", 4, 6, 12, 14, { push = 6 }),
			seg("checkpoint", "lawn", 4, 7, 12, 10),
			seg("spinner", "sprinkler", 4, 7, 14, 14, { spin = 1.6 }),
