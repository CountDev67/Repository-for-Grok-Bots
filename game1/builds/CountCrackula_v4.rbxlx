			seg("mover", "coffin", 4, 2, 6, 6, { move = { axis = "f", amp = 2, period = 3 } }),
			seg("pad", "candle", 4, 3, 6, 6),
			seg("checkpoint", "crypt", 6, 3, 10, 10),
			seg("spinner", "candelabra", 6, 3, 14, 14, { spin = 2.8 }),
			seg("vanish", "cracked", 6, 4, 5, 5),
			seg("vanish", "cracked", 6, 4, 5, 5, { lat = 3 }),
			seg("vanish", "cracked", 6, 5, 5, 5, { lat = -3 }),
			seg("ledge", "brick", 6, 7, 4, 4, { lat = -4, wall = -1 }),
			seg("ledge", "brick", 6, 9, 4, 4, { lat = -4, wall = -1 }),
			seg("beam", "chain", 6, 9, 2, 20),
			seg("checkpoint", "crypt", 6, 9, 10, 10),
			seg("conveyor", "lavabelt", 6, 9, 12, 14, { push = 10 }),
			seg("hurdles", "crypt", 6, 9, 10, 18),
			seg("spinner", "candelabra", 6, 10, 14, 14, { spin = 3.2 }),
			seg("mover", "sarcophagus", 6, 11, 8, 8, { move = { axis = "y", amp = 3, period = 4 } }),
			seg("pad", "candle", 7, 11, 6, 6),
			seg("finish", "crypt", 6, 12, 14, 14),
		},
	},
}

local HEADINGS: { [string]: { fx: number, fz: number, rx: number, rz: number } } = {
	north = { fx = 0, fz = 1, rx = 1, rz = 0 },
	east = { fx = 1, fz = 0, rx = 0, rz = -1 },
	south = { fx = 0, fz = -1, rx = -1, rz = 0 },
	west = { fx = -1, fz = 0, rx = 0, rz = 1 },
}

function CourseLayout.All(): { CourseSpec }
	return COURSES
end

function CourseLayout.Get(id: string): CourseSpec
	for _, spec in COURSES do
		if spec.id == id then
			return spec
		end
	end
	error("unknown course " .. id, 2)
end

function CourseLayout.Heading(spec: CourseSpec): { fx: number, fz: number, rx: number, rz: number }
	local heading = HEADINGS[spec.heading]
	if not heading then
		error(spec.id .. " has an unknown heading " .. tostring(spec.heading), 2)
	end
	return heading
end

-- Local (forward, lat) to world (x, z).
function CourseLayout.ToWorld(spec: CourseSpec, forward: number, lat: number): (number, number)
	local hd = CourseLayout.Heading(spec)
	return spec.originX + hd.fx * forward + hd.rx * lat, spec.originZ + hd.fz * forward + hd.rz * lat
end

-- Local (depth along forward, width along lat) to world (sx, sz).
function CourseLayout.WorldSize(spec: CourseSpec, depth: number, width: number): (number, number)
	local hd = CourseLayout.Heading(spec)
	return math.abs(hd.fx) * depth + math.abs(hd.rx) * width, math.abs(hd.fz) * depth + math.abs(hd.rz) * width
end

function CourseLayout.Lobby(): Aabb & { y: number, sy: number, top: number }
	local sy = 2
	return {
		x = 0,
		z = 0,
		sx = 90,
		sz = 110,
		sy = sy,
		y = CourseLayout.BASE_TOP - sy / 2,
		top = CourseLayout.BASE_TOP,
	}
end

function CourseLayout.SpawnPoint(): (number, number)
	return 0, -6
end

function CourseLayout.Platforms(spec: CourseSpec): { Platform }
	local segments = spec.segments
	local count = #segments
	if count < 3 then
		error(spec.id .. " needs a start, something to jump, and a finish", 2)
	end
	if segments[1].kind ~= "start" then
		error(spec.id .. " must begin with a start segment", 2)
	end
	if segments[count].kind ~= "finish" then
		error(spec.id .. " must end with a finish segment", 2)
	end

	local platforms: { Platform } = {}
	local forward = 0
	local checkpoints = 0
	for index, s in segments do
		if index > 1 then
			local previous = segments[index - 1]
			forward += previous.d / 2 + (s.gap or 0) + s.d / 2
		end
		local role = "jump"
		local number = 0
		if s.kind == "start" then
			role = "start"
		elseif s.kind == "finish" then
			role = "finish"
		elseif s.kind == "checkpoint" then
			role = "checkpoint"
			checkpoints += 1
			number = checkpoints
		end
		local lat = s.lat or 0
		local x, z = CourseLayout.ToWorld(spec, forward, lat)
		local sx, sz = CourseLayout.WorldSize(spec, s.d, s.w)
		local yTop = CourseLayout.BASE_TOP + s.h
		platforms[index] = {
			index = index,
			kind = s.kind,
			look = s.look,
			role = role,
			checkpointNumber = number,
			forward = forward,
			lat = lat,
			h = s.h,
			x = x,
			z = z,
			yTop = yTop,
			yCenter = yTop - spec.thickness / 2,
			width = s.w,
			depth = s.d,
			thickness = spec.thickness,
			sx = sx,
			sz = sz,
			move = s.move,
			spin = s.spin,
			push = s.push,
			wall = s.wall,
		}
	end
	return platforms
end

function CourseLayout.Checkpoints(spec: CourseSpec): { Platform }
	local found = {}
	for _, platform in CourseLayout.Platforms(spec) do
		if platform.role == "checkpoint" then
			table.insert(found, platform)
		end
	end
	return found
end

function CourseLayout.ObstacleCount(spec: CourseSpec): number
	local count = 0
	for _, s in spec.segments do
		if s.kind ~= "start" and s.kind ~= "finish" and s.kind ~= "checkpoint" then
			count += 1
		end
	end
	return count
end

function CourseLayout.JumpArcHeight(horizontalGap: number): number
	local gravity = CourseLayout.GRAVITY
	local verticalSpeed = math.sqrt(2 * gravity * CourseLayout.JUMP_HEIGHT)
	local timeToGap = horizontalGap / CourseLayout.WALK_SPEED
	return verticalSpeed * timeToGap - 0.5 * gravity * timeToGap * timeToGap
end

local function amp(platform: Platform, axis: string): number
	local move = platform.move
	if move and move.axis == axis then
		return move.amp
	end
	return 0
end

export type Transition = {
	fromIndex: number,
	toIndex: number,
	nominalGap: number,
	gap: number,
	step: number,
	clearance: number,
	closestGap: number,
}

-- Worst case over the motion of either end: the longest edge-to-edge reach
-- and the highest climb a player could be forced into.
function CourseLayout.Transitions(spec: CourseSpec): { Transition }
	local platforms = CourseLayout.Platforms(spec)
	local transitions: { Transition } = {}
	for index = 1, #platforms - 1 do
		local a = platforms[index]
		local b = platforms[index + 1]
		local nominal = (b.forward - b.depth / 2) - (a.forward + a.depth / 2)
		local gapF = nominal + amp(a, "f") + amp(b, "f")
		local latSep = math.max(
			0,
			math.abs(b.lat - a.lat) + amp(a, "l") + amp(b, "l") - (a.width + b.width) / 2
		)
		local gap = math.sqrt(gapF * gapF + latSep * latSep)
		local step = (b.h + amp(b, "y")) - (a.h - amp(a, "y"))
		transitions[index] = {
			fromIndex = index,
			toIndex = index + 1,
			nominalGap = nominal,
			gap = gap,
			step = step,
			clearance = CourseLayout.JumpArcHeight(gap) - step,
			closestGap = nominal - amp(a, "f") - amp(b, "f"),
		}
	end
	return transitions
end

-- World-space footprint including how far a mover can travel.
function CourseLayout.Footprint(spec: CourseSpec, platform: Platform): Aabb
	local depth = platform.depth + 2 * amp(platform, "f")
	local width = platform.width + 2 * amp(platform, "l")
	local sx, sz = CourseLayout.WorldSize(spec, depth, width)
	return { x = platform.x, z = platform.z, sx = sx, sz = sz }
end

function CourseLayout.CourseBounds(spec: CourseSpec, pad: number): Aabb
	local minX, maxX = math.huge, -math.huge
	local minZ, maxZ = math.huge, -math.huge
	for _, platform in CourseLayout.Platforms(spec) do
		local box = CourseLayout.Footprint(spec, platform)
		minX = math.min(minX, box.x - box.sx / 2)
		maxX = math.max(maxX, box.x + box.sx / 2)
		minZ = math.min(minZ, box.z - box.sz / 2)
		maxZ = math.max(maxZ, box.z + box.sz / 2)
	end
	return {
		x = (minX + maxX) / 2,
		z = (minZ + maxZ) / 2,
		sx = (maxX - minX) + pad * 2,
		sz = (maxZ - minZ) + pad * 2,
	}
end

function CourseLayout.Overlap(a: Aabb, b: Aabb): (number, number)
	local overlapX = math.min(a.x + a.sx / 2, b.x + b.sx / 2)
		- math.max(a.x - a.sx / 2, b.x - b.sx / 2)
	local overlapZ = math.min(a.z + a.sz / 2, b.z + b.sz / 2)
		- math.max(a.z - a.sz / 2, b.z - b.sz / 2)
	return overlapX, overlapZ
end

-- The walkway from the lobby edge to a course's start platform.
function CourseLayout.Approach(spec: CourseSpec): Aabb & { y: number, sy: number, length: number }
	local lobby = CourseLayout.Lobby()
	local first = CourseLayout.Platforms(spec)[1]
	local hd = CourseLayout.Heading(spec)
	local overlap = 3
	-- Distance from lobby center to the lobby edge along the heading.
	local edge = math.abs(hd.fx) * lobby.sx / 2 + math.abs(hd.fz) * lobby.sz / 2
	local lobbyCenterForward = (lobby.x - spec.originX) * hd.fx + (lobby.z - spec.originZ) * hd.fz
	local fromForward = lobbyCenterForward + edge - overlap
	local toForward = first.forward - first.depth / 2 + 2
	local length = toForward - fromForward
	local mid = (fromForward + toForward) / 2
	local x, z = CourseLayout.ToWorld(spec, mid, first.lat)
	local width = math.max(10, first.width - 2)
	local sx, sz = CourseLayout.WorldSize(spec, length, width)
	return {
		x = x,
		z = z,
		sx = sx,
		sz = sz,
		sy = 2,
		y = CourseLayout.BASE_TOP - 1,
		length = length,
	}
end

-- Kept for callers of the old API.
function CourseLayout.EastBridge(): Aabb & { y: number, sy: number }
	return CourseLayout.Approach(CourseLayout.Get("stage2"))
end

-- One sign per course, on an arch over the approach, facing the spawn.
function CourseLayout.EntranceSign(
	spec: CourseSpec
): { x: number, y: number, z: number, width: number, height: number, faceX: number, faceZ: number }
	local lobby = CourseLayout.Lobby()
	local hd = CourseLayout.Heading(spec)
	local edge = math.abs(hd.fx) * lobby.sx / 2 + math.abs(hd.fz) * lobby.sz / 2
	local first = CourseLayout.Platforms(spec)[1]
	local latWorldX = hd.rx * first.lat
	local latWorldZ = hd.rz * first.lat
	return {
		x = lobby.x + hd.fx * (edge - 2) + latWorldX,
		y = CourseLayout.BASE_TOP + 13,
		z = lobby.z + hd.fz * (edge - 2) + latWorldZ,
		width = 16,
		height = 5,
		faceX = -hd.fx,
		faceZ = -hd.fz,
	}
end

function CourseLayout.EncodeCheckpoint(courseId: string, number: number): string
	if number <= 1 then
		return courseId
	end
	return courseId .. "#" .. tostring(math.floor(number))
end

function CourseLayout.DecodeCheckpoint(value: any): (string?, number)
	if type(value) ~= "string" or value == "" then
		return nil, 0
	end
	local id, number = string.match(value, "^([%w_]+)#(%d+)$")
	if id and number then
		return id, math.max(1, tonumber(number) or 1)
	end
	if string.match(value, "^[%w_]+$") then
		return value, 1
	end
	return nil, 0
end

local PAD_X = -70
local PAD_OFFSETS = { -12, 0, 12 }
local PAD_SIZE = 8
local SLOT_SPACING = 40
local MAX_SLOTS = 6

function CourseLayout.MaxPorchSlots(): number
	return MAX_SLOTS
end

function CourseLayout.PadPlacements(
	slotIndex: number
): { { x: number, z: number, size: number, top: number } }
	local slotZ = (slotIndex - 1) * SLOT_SPACING
	local placements = {}
	for index, offset in PAD_OFFSETS do
		placements[index] = {
			x = PAD_X,
			z = slotZ + offset,
			size = PAD_SIZE,
			top = CourseLayout.BASE_TOP,
		}
	end
	return placements
end

-- The tier-2 Crypt Key pad, beside the three porch pads.
function CourseLayout.UpgradePlacement(slotIndex: number): { x: number, z: number, size: number, top: number }
	local slotZ = (slotIndex - 1) * SLOT_SPACING
	return { x = -61, z = slotZ + 18, size = 6, top = CourseLayout.BASE_TOP }
end

function CourseLayout.ModelPoint(
	placement: { x: number, z: number, top: number }
): (number, number, number)
	return placement.x - 16, placement.top, placement.z
end

function CourseLayout.PorchDeck(): Aabb & { y: number, sy: number, top: number }
	local padHalf = PAD_SIZE / 2
	local zMin = 0 - 12 - padHalf - 8
	local zMax = (MAX_SLOTS - 1) * SLOT_SPACING + 12 + padHalf + 8
	local xMin = -98
	local xMax = -56
	local sy = 2
	return {
		x = (xMin + xMax) / 2,
		z = (zMin + zMax) / 2,
		sx = xMax - xMin,
		sz = zMax - zMin,
		sy = sy,
		y = CourseLayout.BASE_TOP - sy / 2,
		top = CourseLayout.BASE_TOP,
	}
end

function CourseLayout.PorchWalkway(): Aabb & { y: number, sy: number }
	local lobby = CourseLayout.Lobby()
	local deck = CourseLayout.PorchDeck()
	local overlap = 3
	local xMin = (deck.x + deck.sx / 2) - overlap
	local xMax = (lobby.x - lobby.sx / 2) + overlap
	return {
		x = (xMin + xMax) / 2,
		z = 0,
		sx = xMax - xMin,
		sz = 16,
		sy = 2,
		y = CourseLayout.BASE_TOP - 1,
	}
end

function CourseLayout.Contains(bounds: Aabb, x: number, z: number, half: number): boolean
	if x - half < bounds.x - bounds.sx / 2 then
		return false
	end
	if x + half > bounds.x + bounds.sx / 2 then
		return false
	end
	if z - half < bounds.z - bounds.sz / 2 then
		return false
	end
	if z + half > bounds.z + bounds.sz / 2 then
		return false
	end
	return true
end

return CourseLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--!strict
-- Server-authoritative cash. The module is shared so the API is one place;
-- each VM has its own table. Mutations throw on the client.
-- Changed:Fire(player, cash, delta, reason)

local Signal
if script ~= nil then
	Signal = require(script.Parent.Signal)
else
	Signal = require("./Signal")
end

local Economy = {}
Economy.Changed = Signal.new()

Economy.Reasons = {
	StageClear = "stage_clear",
	Checkpoint = "checkpoint",
	TimerBonus = "timer_bonus",
	DailyShift = "daily_shift",
	DevProduct = "dev_product",
	OfflineTycoon = "offline_tycoon",
	BasePad = "base_pad",
	Hydrate = "hydrate",
	Admin = "admin",
}

local MULTIPLIED: { [string]: boolean } = {
	stage_clear = true,
	checkpoint = true,
	timer_bonus = true,
	daily_shift = true,
	offline_tycoon = true,
}

local cashByUser: { [number]: number } = {}
local multiplierByUser: { [number]: number } = {}
local authorityOverride: boolean? = nil

local function userIdOf(player: any): number
	local userId = player and player.UserId
	if type(userId) ~= "number" then
		error("expected a player with a numeric UserId", 3)
	end
	return userId
end

local function isAuthoritative(): boolean
	if authorityOverride ~= nil then
		return authorityOverride
	end
	local ok, server = pcall(function()
		return game:GetService("RunService"):IsServer()
	end)
	if not ok then
		return true
	end
	return server == true
end

local function assertServer()
	if not isAuthoritative() then
		error("Economy mutations are server-authoritative", 2)
	end
end

local function assertReason(reason: any)
	if type(reason) ~= "string" or reason == "" then
		error("cash reason must be a non-empty string", 3)
	end
end

local function assertPositiveInt(amount: any, name: string)
	if
		type(amount) ~= "number"
		or amount ~= amount
		or amount == math.huge
		or amount <= 0
		or amount ~= math.floor(amount)
	then
		error(name .. " expects a positive integer", 3)
	end
end

local function assertNonNegativeInt(amount: any, name: string)
	if
		type(amount) ~= "number"
		or amount ~= amount
		or amount == math.huge
		or amount < 0
		or amount ~= math.floor(amount)
	then
		error(name .. " expects a non-negative integer", 3)
	end
end

function Economy.GetCash(player: any): number
	return cashByUser[userIdOf(player)] or 0
end

function Economy.GetEarnMultiplier(player: any): number
	return multiplierByUser[userIdOf(player)] or 1
end

function Economy.SetEarnMultiplier(player: any, multiplier: number)
	assertServer()
	if
		type(multiplier) ~= "number"
		or multiplier ~= multiplier
		or multiplier < 1
		or multiplier == math.huge
	then
		error("earn multiplier must be a finite number >= 1", 2)
	end
	multiplierByUser[userIdOf(player)] = multiplier
end

function Economy.AddCash(player: any, amount: number, reason: string)
	assertServer()
	assertPositiveInt(amount, "AddCash")
	assertReason(reason)
	local userId = userIdOf(player)
	local multiplier = 1
	if MULTIPLIED[reason] then
		multiplier = multiplierByUser[userId] or 1
	end
	local applied = math.floor(amount * multiplier + 1e-6)
	local nextCash = (cashByUser[userId] or 0) + applied
	cashByUser[userId] = nextCash
	Economy.Changed:Fire(player, nextCash, applied, reason)
end

function Economy.TrySpend(player: any, amount: number, reason: string): boolean
	assertServer()
	assertPositiveInt(amount, "TrySpend")
	assertReason(reason)
	local userId = userIdOf(player)
	local current = cashByUser[userId] or 0
	if current < amount then
		return false
	end
	local nextCash = current - amount
	cashByUser[userId] = nextCash
	Economy.Changed:Fire(player, nextCash, -amount, reason)
	return true
end

function Economy.Hydrate(player: any, amount: number)
	assertServer()
	assertNonNegativeInt(amount, "Hydrate")
	local userId = userIdOf(player)
	local previous = cashByUser[userId] or 0
	cashByUser[userId] = amount
	if amount == previous then
		return
	end
	Economy.Changed:Fire(player, amount, amount - previous, Economy.Reasons.Hydrate)
end

function Economy.Forget(player: any)
	local userId = userIdOf(player)
	cashByUser[userId] = nil
	multiplierByUser[userId] = nil
end

function Economy._setAuthority(value: boolean?)
	authorityOverride = value
end

function Economy._reset()
	table.clear(cashByUser)
	table.clear(multiplierByUser)
	authorityOverride = nil
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">JsonCopy</string>
          <string name="Source"><![CDATA[--!strict
-- Deep copy of JSON-ish values. Drops functions, threads, and userdata.
-- Cycles are skipped so a bad blob cannot loop forever.

local function copy(value: any, seen: { [any]: boolean }): any
	local kind = type(value)
	if kind == "number" or kind == "string" or kind == "boolean" then
		return value
	end
	if kind ~= "table" then
		return nil
	end
	if seen[value] then
		return nil
	end
	seen[value] = true
	local out = {}
	for key, child in value do
		if type(key) == "string" or type(key) == "number" then
			local cloned = copy(child, seen)
			if cloned ~= nil then
				out[key] = cloned
			end
		end
	end
	return out
end

local function JsonCopy(value: any): any
	return copy(value, {})
end

return JsonCopy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">PorchPads</string>
          <string name="Source"><![CDATA[--!strict
-- Placeholder porch purchases. The base team replaces the pads;
-- the prices here are the playable slice, not the later tycoon curve.

local PorchPads = {}

export type PadDef = {
	id: string,
	name: string,
	cost: number,
	kind: string,
	blurb: string,
}

export type OwnedMap = { [string]: boolean }

export type Preview = {
	ok: boolean,
	reason: string,
	cost: number?,
	owned: OwnedMap?,
	tier: number?,
}

local DEFS: { PadDef } = {
	{
		id = "bench",
		name = "Porch Bench",
		cost = 50,
		kind = "bench",
		blurb = "Sit down. The Count's feet filed a complaint.",
	},
	{
		id = "icebath",
		name = "Ice Bath",
		cost = 100,
		kind = "icebath",
		blurb = "For sore rugby feet. Water not included, the look is.",
	},
	{
		id = "shrine",
		name = "DoorDash Bag Shrine",
		cost = 150,
		kind = "shrine",
		blurb = "A red delivery bag on a pedestal. Reverence, then tips.",
	},
}

local BY_ID: { [string]: PadDef } = {}
for _, def in DEFS do
	BY_ID[def.id] = def
end

PorchPads.Defs = DEFS

-- Tier 2: one more porch buy after the first three. Opens Sore Foot Lava Crypt.
-- Its cost is BaseConfig tier 2's price (a test keeps them equal).
PorchPads.Upgrade = {
	id = "cryptkey",
	name = "Crypt Key",
	cost = 1500,
	kind = "cryptkey",
	blurb = "A big goofy skeleton key. Opens the lava crypt behind the manor.",
	tier = 2,
	requiresTier = 1,
}

function PorchPads.PreviewUpgrade(owned: OwnedMap, tier: number, cash: number): Preview
	local def = PorchPads.Upgrade
	if owned[def.id] == true or tier >= def.tier then
		return { ok = false, reason = "already", cost = def.cost }
	end
	if tier < def.requiresTier or not PorchPads.OwnsAll(owned) then
		return { ok = false, reason = "tier", cost = def.cost }
	end
	if type(cash) ~= "number" or cash < def.cost then
		return { ok = false, reason = "poor", cost = def.cost }
	end
	local nextOwned: OwnedMap = table.clone(owned)
	nextOwned[def.id] = true
	return { ok = true, reason = "ok", cost = def.cost, owned = nextOwned, tier = def.tier }
end

function PorchPads.Get(id: string): PadDef?
	return BY_ID[id]
end

function PorchPads.OwnsAll(owned: OwnedMap): boolean
	for _, def in DEFS do
		if owned[def.id] ~= true then
			return false
		end
	end
	return true
end

function PorchPads.Preview(owned: OwnedMap, padId: string, cash: number): Preview
	local def = BY_ID[padId]
	if not def then
		return { ok = false, reason = "unknown" }
	end
	if owned[padId] == true then
		return { ok = false, reason = "already", cost = def.cost }
	end
	if type(cash) ~= "number" or cash < def.cost then
		return { ok = false, reason = "poor", cost = def.cost }
	end
	local nextOwned: OwnedMap = table.clone(owned)
	nextOwned[padId] = true
	local tier = if PorchPads.OwnsAll(nextOwned) then 1 else 0
	return {
		ok = true,
		reason = "ok",
		cost = def.cost,
		owned = nextOwned,
		tier = tier,
	}
end

return PorchPads
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="9">
        <Properties>
          <string name="Name">Retention</string>
        </Properties>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">OfflineIncome</string>
            <string name="Source"><![CDATA[--!strict
-- Cap hook for the base team's offline tycoon math.
-- Call Retention.GrantOfflineIncome once per join; this function is the pure cap.
-- Tier < 1 uses the tier-1 rate. Tier > 3 uses the tier-3 rate.
-- Nothing accrues past MaxHours.

local OfflineIncome = {}

OfflineIncome.PerHour = { 400, 1200, 4000 }
OfflineIncome.MaxHours = 8

function OfflineIncome.Cap(raw: any, elapsedSeconds: any, tier: any): number
	if type(raw) ~= "number" or raw ~= raw or raw <= 0 or raw == math.huge then
		return 0
	end
	if
		type(elapsedSeconds) ~= "number"
		or elapsedSeconds ~= elapsedSeconds
		or elapsedSeconds <= 0
	then
		return 0
	end
	local tierIndex = if type(tier) == "number" then math.floor(tier) else 1
	if tierIndex < 1 then
		tierIndex = 1
	end
	if tierIndex > #OfflineIncome.PerHour then
		tierIndex = #OfflineIncome.PerHour
	end
	local hours = math.min(elapsedSeconds / 3600, OfflineIncome.MaxHours)
	local cap = math.floor(OfflineIncome.PerHour[tierIndex] * hours + 1e-6)
	return math.min(math.floor(raw), cap)
end

return OfflineIncome
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Streak</string>
            <string name="Source"><![CDATA[--!strict
-- DoorDash shift. UTC day numbers (floor(os.time() / 86400)).
-- Missing a day resets to 1. After day 7 the next day starts a new week.
-- The sock is once per account, not a tradable Roblox Limited.

local Streak = {}

Streak.Rewards = { 200, 400, 600, 800, 1000, 1400, 2200 }

export type State = {
	lastClaimDay: number,
	streak: number,
	bestStreak: number,
	sockGranted: boolean,
}

export type Reward = {
	day: number,
	cash: number,
	sock: boolean,
}

function Streak.Fresh(): State
	return { lastClaimDay = 0, streak = 0, bestStreak = 0, sockGranted = false }
end

local function nextDay(state: State, today: number): number?
	if state.lastClaimDay == 0 then
		return 1
	end
	local gap = today - state.lastClaimDay
	if gap <= 0 then
		return nil
	end
	if gap == 1 then
		if state.streak >= 7 then
			return 1
		end
		return state.streak + 1
	end
	return 1
end

function Streak.Claim(state: State, today: number): (boolean, State, Reward?, string?)
	if type(today) ~= "number" then
		return false, state, nil, "bad_day"
	end
	local day = nextDay(state, today)
	if not day then
		return false, state, nil, "already_claimed"
	end
	local grantSock = day == 7 and state.sockGranted ~= true
	local newState: State = {
		lastClaimDay = today,
		streak = day,
		bestStreak = math.max(state.bestStreak or 0, day),
		sockGranted = state.sockGranted == true or grantSock,
	}
	local reward: Reward = {
		day = day,
		cash = Streak.Rewards[day],
		sock = grantSock,
	}
	return true, newState, reward, nil
end

return Streak
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="12">
