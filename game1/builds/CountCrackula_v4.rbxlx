    <Item class="StarterPlayerScripts" referent="39">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="40">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local gui = Instance.new("ScreenGui")
gui.Name = "CrackulaHud"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local panel = Instance.new("Frame")
panel.Name = "CashPanel"
panel.AnchorPoint = Vector2.new(0.5, 0)
panel.Position = UDim2.new(0.5, 0, 0, 12)
panel.Size = UDim2.fromOffset(240, 72)
panel.BackgroundColor3 = Color3.fromRGB(28, 20, 24)
panel.BackgroundTransparency = 0.15
panel.BorderSizePixel = 0
panel.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = panel

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 186, 92)
stroke.Thickness = 1.5
stroke.Transparency = 0.2
stroke.Parent = panel

local title = Instance.new("TextLabel")
title.BackgroundTransparency = 1
title.Position = UDim2.fromOffset(12, 8)
title.Size = UDim2.new(1, -24, 0, 18)
title.Font = Enum.Font.Gotham
pcall(function()
	title.Font = Enum.Font.Creepster
end)
title.TextSize = 14
title.TextXAlignment = Enum.TextXAlignment.Left
title.TextColor3 = Color3.fromRGB(255, 186, 92)
title.Text = "COUNT CRACKULA"
title.Parent = panel

local cashLabel = Instance.new("TextLabel")
cashLabel.BackgroundTransparency = 1
cashLabel.Position = UDim2.fromOffset(12, 28)
cashLabel.Size = UDim2.new(1, -24, 0, 36)
cashLabel.Font = Enum.Font.GothamBold
cashLabel.TextSize = 28
cashLabel.TextXAlignment = Enum.TextXAlignment.Left
cashLabel.TextColor3 = Color3.fromRGB(255, 244, 230)
cashLabel.Text = "Cash  0"
cashLabel.Parent = panel

local toast = Instance.new("TextLabel")
toast.Name = "Toast"
toast.AnchorPoint = Vector2.new(0.5, 1)
toast.Position = UDim2.new(0.5, 0, 1, -28)
toast.Size = UDim2.new(0.9, 0, 0, 44)
toast.BackgroundColor3 = Color3.fromRGB(28, 20, 24)
toast.BackgroundTransparency = 0.1
toast.Font = Enum.Font.GothamBold
toast.TextSize = 18
toast.TextColor3 = Color3.fromRGB(255, 244, 230)
toast.Text = ""
toast.Visible = false
toast.Parent = gui
local toastCorner = Instance.new("UICorner")
toastCorner.CornerRadius = UDim.new(0, 8)
toastCorner.Parent = toast

local toastToken = 0
local function showToast(message: string)
	toastToken += 1
	local token = toastToken
	toast.Text = message
	toast.Visible = true
	task.delay(3.4, function()
		if toastToken == token then
			toast.Visible = false
		end
	end)
end

local remotes = ReplicatedStorage:WaitForChild("Remotes", 30)
if remotes then
	local notify = remotes:WaitForChild("Notify")
	if notify and notify:IsA("RemoteEvent") then
		notify.OnClientEvent:Connect(function(message)
			if type(message) == "string" then
				showToast(message)
			end
		end)
	end
else
	showToast("Still tying the cleats…")
end

local leaderstats = player:WaitForChild("leaderstats", 30)
if leaderstats then
	local cash = leaderstats:WaitForChild("Cash", 10)
	if cash and cash:IsA("IntValue") then
		local function render()
			cashLabel.Text = "Cash  " .. tostring(cash.Value)
		end
		render()
		cash.Changed:Connect(render)
	end
end

local ShopGui = require(script.ShopGui)
ShopGui.Attach(gui, showToast)

require(script.Bats).Start()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Bats</string>
            <string name="Source"><![CDATA[--!strict
-- Purely cosmetic, client-side: circles and flaps the bats the server built
-- under workspace.CountCrackulaMap.Bats,.
-- Local CFrame writes never replicate, so this costs the server nothing.

local RunService = game:GetService("RunService")

local Bats = {}

type Bat = {
	parts: { { part: BasePart, offset: CFrame, side: number } },
	center: Vector3,
	radius: number,
	speed: number,
	phase: number,
	bob: number,
}

function Bats.Start()
	task.spawn(function()
		local map = workspace:WaitForChild("CountCrackulaMap", 60)
		local folder = map and map:WaitForChild("Bats", 30)
		if not folder then
			return
		end
		local bats: { Bat } = {}
		for _, model in folder:GetChildren() do
			if model:IsA("Model") and model.PrimaryPart then
				local root = model.PrimaryPart :: BasePart
				local center = model:GetAttribute("Center")
				if typeof(center) ~= "Vector3" then
					continue
				end
				local entry: Bat = {
					parts = {},
					center = center :: Vector3,
					radius = tonumber(model:GetAttribute("Radius")) or 16,
					speed = tonumber(model:GetAttribute("Speed")) or 0.8,
					phase = tonumber(model:GetAttribute("Phase")) or 0,
					bob = tonumber(model:GetAttribute("Bob")) or 2,
				}
				for _, child in model:GetChildren() do
					if child:IsA("BasePart") then
						local side = child:GetAttribute("Side")
						table.insert(entry.parts, {
							part = child,
							offset = root.CFrame:ToObjectSpace(child.CFrame),
							side = if type(side) == "number" then side else 0,
						})
					end
				end
				table.insert(bats, entry)
			end
		end
		RunService.RenderStepped:Connect(function()
			local t = os.clock()
			for _, bat in bats do
				local angle = bat.phase + t * bat.speed
				local pos = bat.center
					+ Vector3.new(math.cos(angle) * bat.radius, math.sin(t * 2 + bat.phase) * bat.bob, math.sin(angle) * bat.radius)
				local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle)) * math.sign(bat.speed)
				local root = CFrame.lookAt(pos, pos + tangent)
				local flap = math.sin(t * 14 + bat.phase) * 0.6
				for _, piece in bat.parts do
					local cf = root * piece.offset
					if piece.side ~= 0 then
						cf = root * CFrame.Angles(0, 0, -piece.side * flap) * piece.offset
					end
					piece.part.CFrame = cf
				end
			end
		end)
	end)
end

return Bats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">ShopGui</string>
            <string name="Source"><![CDATA[--!strict
-- Shop list. Ids of 0 stay on the board until the dashboard SKUs exist.
-- Prompts are client-side. Grants happen on the server.

local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Catalog =
	require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Shop"):WaitForChild("Catalog"))

local ShopGui = {}

function ShopGui.Attach(gui: ScreenGui, toast: (string) -> ())
	local open = Instance.new("TextButton")
	open.Name = "ShopButton"
	open.AnchorPoint = Vector2.new(1, 0)
	open.Position = UDim2.new(1, -12, 0, 12)
	open.Size = UDim2.fromOffset(88, 40)
	open.BackgroundColor3 = Color3.fromRGB(226, 48, 42)
	open.Font = Enum.Font.GothamBold
	open.TextSize = 16
	open.TextColor3 = Color3.fromRGB(255, 244, 230)
	open.Text = "Shop"
	open.AutoButtonColor = true
	open.Parent = gui
	local openCorner = Instance.new("UICorner")
	openCorner.CornerRadius = UDim.new(0, 8)
	openCorner.Parent = open

	local panel = Instance.new("Frame")
	panel.Name = "Shop"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromScale(0.92, 0.78)
	panel.BackgroundColor3 = Color3.fromRGB(24, 18, 22)
	panel.Visible = false
	panel.Parent = gui
	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, 12)
	panelCorner.Parent = panel
	local sizeCap = Instance.new("UISizeConstraint")
	sizeCap.MaxSize = Vector2.new(480, 560)
	sizeCap.MinSize = Vector2.new(280, 320)
	sizeCap.Parent = panel

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(16, 10)
	title.Size = UDim2.new(1, -80, 0, 28)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 20
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Color3.fromRGB(255, 214, 140)
	title.Text = "Count's bag"
	title.Parent = panel

	local close = Instance.new("TextButton")
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -10, 0, 10)
	close.Size = UDim2.fromOffset(36, 28)
	close.BackgroundTransparency = 1
	close.Font = Enum.Font.GothamBold
	close.TextSize = 18
	close.TextColor3 = Color3.fromRGB(255, 244, 230)
	close.Text = "X"
	close.Parent = panel

	local scroller = Instance.new("ScrollingFrame")
	scroller.Position = UDim2.fromOffset(12, 48)
	scroller.Size = UDim2.new(1, -24, 1, -60)
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.ScrollBarThickness = 6
	scroller.CanvasSize = UDim2.fromOffset(0, 0)
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroller.Parent = panel
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.Parent = scroller

	local function addRow(kind: string, def)
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -8, 0, 72)
		row.BackgroundColor3 = Color3.fromRGB(40, 30, 36)
		row.Parent = scroller
		local rowCorner = Instance.new("UICorner")
		rowCorner.CornerRadius = UDim.new(0, 8)
		rowCorner.Parent = row

		local name = Instance.new("TextLabel")
		name.BackgroundTransparency = 1
		name.Position = UDim2.fromOffset(10, 6)
		name.Size = UDim2.new(1, -110, 0, 22)
		name.Font = Enum.Font.GothamBold
		name.TextSize = 16
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.TextColor3 = Color3.fromRGB(255, 244, 230)
		name.Text = def.name
		name.Parent = row

		local blurb = Instance.new("TextLabel")
		blurb.BackgroundTransparency = 1
		blurb.Position = UDim2.fromOffset(10, 28)
		blurb.Size = UDim2.new(1, -110, 0, 36)
		blurb.Font = Enum.Font.Gotham
		blurb.TextSize = 13
		blurb.TextXAlignment = Enum.TextXAlignment.Left
		blurb.TextYAlignment = Enum.TextYAlignment.Top
		blurb.TextWrapped = true
		blurb.TextColor3 = Color3.fromRGB(214, 190, 180)
		blurb.Text = def.blurb
		blurb.Parent = row

		local buy = Instance.new("TextButton")
		buy.AnchorPoint = Vector2.new(1, 0.5)
		buy.Position = UDim2.new(1, -8, 0.5, 0)
		buy.Size = UDim2.fromOffset(84, 32)
		buy.BackgroundColor3 = Color3.fromRGB(255, 186, 92)
		buy.Font = Enum.Font.GothamBold
		buy.TextSize = 14
		buy.TextColor3 = Color3.fromRGB(28, 18, 16)
		buy.Text = if def.id == 0 then "No id" else (tostring(def.price) .. " R$")
		buy.Parent = row
		local buyCorner = Instance.new("UICorner")
		buyCorner.CornerRadius = UDim.new(0, 6)
		buyCorner.Parent = buy
		buy.Activated:Connect(function()
			if def.id == 0 then
				toast(def.name .. " still has placeholder id 0.")
				return
			end
			local ok = pcall(function()
				if kind == "pass" then
					MarketplaceService:PromptGamePassPurchase(def.id)
				else
					MarketplaceService:PromptProductPurchase(def.id)
				end
			end)
			if not ok then
				toast("Purchases need a published place.")
			end
		end)
	end

	for _, pass in Catalog.Passes do
		addRow("pass", pass)
	end
	for _, product in Catalog.Products do
		addRow("product", product)
	end

	open.Activated:Connect(function()
		panel.Visible = not panel.Visible
	end)
	close.Activated:Connect(function()
		panel.Visible = false
	end)

	local remotes = ReplicatedStorage:WaitForChild("Remotes", 30)
	local refresh = if remotes then remotes:WaitForChild("RefreshPasses", 30) else nil
	if refresh and refresh:IsA("RemoteEvent") then
		local function ping()
			refresh:FireServer()
		end
		MarketplaceService.PromptGamePassPurchaseFinished:Connect(ping)
		MarketplaceService.PromptProductPurchaseFinished:Connect(ping)
	end
end

return ShopGui
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
