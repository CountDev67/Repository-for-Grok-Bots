      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">BaseConfig</string>
          <string name="Source"><![CDATA[--!strict
-- TODO(base-team): Replace these placeholder tiers with the real tycoon.
-- Tier 1's price matches the three porch pads (50 + 100 + 150). The slice
-- charges those pads, then sets BaseService tier to 1. Tier 2 is the porch's
-- Crypt Key (PorchPads.Upgrade, 1500 = 10 Graveyard Rugby Rush runs) and opens
-- Sore Foot Lava Crypt. Tier 3 is still a stub for droppers you have not built
-- yet. See docs/PAYOUT_CURVE.md before retuning.

local BaseConfig = {
	tiers = {
		{
			tier = 1,
			id = "porch",
			name = "Porch",
			price = 300,
			blurb = "Bench, ice bath, and a delivery-bag shrine.",
		},
		{
			tier = 2,
			id = "cryptkey",
			name = "Crypt Key",
			price = 1500,
			blurb = "Opens Sore Foot Lava Crypt. TODO(base-team): droppers can raise this.",
		},
		{
			tier = 3,
			id = "keep",
			name = "Castle Keep",
			price = 80000,
			blurb = "TODO(base-team): endgame base. Placeholder price only.",
		},
	},
}

function BaseConfig.Get(tier: number)
	for _, entry in BaseConfig.tiers do
		if entry.tier == tier then
			return entry
		end
	end
	return nil
end

return BaseConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">CourseLayout</string>
          <string name="Source"><![CDATA[--!strict
-- Source of truth for the map. Pure data and math, no Instances, so Lune can
-- test it. World builds whatever this module describes.
-- Jump numbers match a default Roblox character:
-- JumpHeight 7.2, WalkSpeed 16, gravity 196.2.
--
-- Courses are lists of segments in course-local space:
--   forward = distance along the course heading, lat = sideways offset,
--   h = top height above BASE_TOP. `gap` is the edge-to-edge forward gap from
--   the previous segment. Moving segments carry `move` (axis f / l / y and an
--   amplitude); Transitions() checks every jump at the worst phase of motion.

local CourseLayout = {}

CourseLayout.JUMP_HEIGHT = 7.2
CourseLayout.WALK_SPEED = 16
CourseLayout.GRAVITY = 196.2
CourseLayout.BASE_TOP = 13
CourseLayout.GROUND_TOP = 2
CourseLayout.MAX_GAP = 8

export type Aabb = { x: number, z: number, sx: number, sz: number }

export type Move = { axis: string, amp: number, period: number }

export type Segment = {
	kind: string, -- start | pad | beam | mover | spinner | vanish | conveyor | ledge | hurdles | checkpoint | finish
	look: string,
	gap: number?,
	lat: number?,
	h: number,
	w: number,
	d: number,
	move: Move?,
	spin: number?,
	push: number?,
	wall: number?,
}

export type Palette = {
	base: { number },
	alt: { number },
	accent: { number },
	kill: { number },
	checkpoint: { number },
	finish: { number },
	trim: { number },
}

export type CourseSpec = {
	id: string,
	displayName: string,
	tagline: string,
	payout: number,
	requiredTier: number,
	lockHint: string,
	heading: string,
	originX: number,
	originZ: number,
	thickness: number,
	minClearance: number,
	palette: Palette,
	segments: { Segment },
}

export type Platform = {
	index: number,
	kind: string,
	look: string,
	role: string,
	checkpointNumber: number,
	forward: number,
	lat: number,
	h: number,
	x: number,
	z: number,
	yTop: number,
	yCenter: number,
	width: number,
	depth: number,
	thickness: number,
	sx: number,
	sz: number,
	move: Move?,
	spin: number?,
	push: number?,
	wall: number?,
}

local function seg(
	kind: string,
	look: string,
	gap: number,
	h: number,
	w: number,
	d: number,
	extra: { [string]: any }?
): Segment
	local s: any = { kind = kind, look = look, gap = gap, h = h, w = w, d = d }
	if extra then
		for key, value in extra do
			s[key] = value
		end
	end
	return s :: Segment
end

