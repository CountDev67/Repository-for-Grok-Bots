			seg("pad", "porch", 4, 2, 10, 8),
			seg("pad", "porch", 4, 4, 10, 8),
			seg("beam", "fence", 4, 4, 2, 18),
			seg("pad", "pumpkin", 4, 4, 6, 6, { lat = 4 }),
